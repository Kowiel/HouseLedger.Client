{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "HouseLedger",
    "Audience": "HouseLedger.Client",
    "AccessTokenLifetimeMinutes": 15
  },
  "Session": {
    "AbsoluteLifetimeHours": 8,
    "InactivityTimeoutMinutes": 10
  }
}
