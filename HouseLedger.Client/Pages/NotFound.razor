@page "/not-found"
@layout MainLayout

<div class="not-found-page">
    <div class="not-found-orb" aria-hidden="true">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
    </div>

    <MudText Typo="Typo.overline" Class="error-label">ERROR 404</MudText>
    <MudText Typo="Typo.h2" Class="not-found-title">Page not found</MudText>
    <MudText Typo="Typo.body1" Class="not-found-message">
        Sorry, we couldn’t find the page you were looking for. It may have moved or no longer exists.
    </MudText>

    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack" Class="home-button">
        Back to dashboard
    </MudButton>
</div>
