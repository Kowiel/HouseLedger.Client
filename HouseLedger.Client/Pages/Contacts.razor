        new() { Id = Guid.NewGuid(), DisplayName = "Taylor Smith", Email = "taylor.smith@example.com", PhoneNumber = "+1 (555) 012-7810", Notes = "Neighbor" },
        new() { Id = Guid.NewGuid(), DisplayName = "Jordan Williams", Email = "jordan.williams@example.com", PhoneNumber = "+1 (555) 016-4390", Notes = "Family contact" },
        new() { Id = Guid.NewGuid(), DisplayName = "Casey Brown", Email = "casey.brown@example.com", PhoneNumber = "+1 (555) 019-6274", Notes = "Household contact" },
        new() { Id = Guid.NewGuid(), DisplayName = "Riley Davis", Email = "riley.davis@example.com", PhoneNumber = "+1 (555) 013-8051", Notes = "Friend" },
        new() { Id = Guid.NewGuid(), DisplayName = "Jamie Wilson", Email = "jamie.wilson@example.com", PhoneNumber = "+1 (555) 017-2916", Notes = "Emergency contact" },
