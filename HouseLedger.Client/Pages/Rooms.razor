@page "/rooms"
@attribute [Authorize]
@using HouseLedger.Client.RoomService
@using HouseLedger.Client.ToolService
@using HouseLedger.Shared.DTO.Room
@using HouseLedger.Shared.DTO.Tool
@using HouseLedger.Shared.Models
@inject IRoomService RoomService
@inject IToolService ToolService

<PageTitle>Rooms</PageTitle>

<div class="rooms-page @(showPanel ? "panel-open" : "list-centered")">
    <div class="rooms-heading">
        <div class="rooms-page-icon"><MudIcon Icon="@Icons.Material.Filled.MeetingRoom" /></div>
        <div>
            <MudText Typo="Typo.h3" Class="rooms-title">Rooms</MudText>
            <MudText Typo="Typo.body1" Class="rooms-subtitle">Organize your home and see what is stored in each space.</MudText>
        </div>
    </div>

    <div class="rooms-workspace @(showPanel ? "panel-open" : string.Empty)">
        <div class="room-tiles">
            <div class="room-grid-toolbar">
                <div>
                    <MudText Typo="Typo.h6">Your rooms</MudText>
                    <MudText Typo="Typo.caption">@rooms.Count room@(rooms.Count == 1 ? string.Empty : "s")</MudText>
                </div>
                <div class="room-toolbar-actions">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RefreshRooms" AriaLabel="Refresh rooms" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAdd">Add room</MudButton>
                </div>
            </div>

            <div class="room-grid">
                @foreach (var room in rooms)
                {
                    <RoomTile Room="room" Selected="@(selectedRoom?.Id == room.Id)" OnSelected="OpenRoom" />
                }
            </div>
        </div>

        @if (showPanel)
        {
            <div class="room-panel">
                <div class="room-panel-toolbar">
                    <MudText Typo="Typo.subtitle1">@(isAdding ? "New room" : isEditing ? "Edit room" : "Room details")</MudText>
                    <div>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Inherit" Size="Size.Small" OnClick="RefreshRooms" AriaLabel="Refresh rooms" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Size="Size.Small" OnClick="ClosePanel" AriaLabel="Close room panel" />
                    </div>
                </div>

                @if (isAdding)
                {
                    <AddRoom OnSaved="CreateRoom" OnCancel="ClosePanel" />
                }
                else if (isEditing && selectedRoom is not null)
                {
                    <EditRoom Room="selectedRoom" OnSaved="UpdateRoom" OnCancel="ClosePanel" />
                }
                else if (selectedRoom is not null)
                {
                    <RoomDetails Room="selectedRoom" AvailableTools="tools" OnAssignTool="AssignToolToRoom" OnEdit="OpenEdit" OnClose="ClosePanel" />
                }
            </div>
        }
    </div>
</div>

@code {
    private List<Room> rooms = [];
    private List<Tool> tools = [];
    private Room? selectedRoom;
    private bool showPanel;
    private bool isAdding;
    private bool isEditing;

    protected override Task OnInitializedAsync() => RefreshRooms();

    private void OpenRoom(Room room)
    {
        selectedRoom = room;
        showPanel = true;
        isAdding = false;
        isEditing = false;
    }

    private void OpenAdd()
    {
        selectedRoom = null;
        showPanel = true;
        isAdding = true;
        isEditing = false;
    }

    private void OpenEdit()
    {
        if (selectedRoom is not null)
        {
            showPanel = true;
            isAdding = false;
            isEditing = true;
        }
    }

    private void ClosePanel()
    {
        showPanel = false;
        isAdding = false;
        isEditing = false;
    }

    private async Task RefreshRooms()
    {
        await LoadRoomData();

        selectedRoom = null;
        ClosePanel();
    }

    private async Task LoadRoomData()
    {
        var roomsTask = RoomService.GetAllAsync();
        var toolsTask = ToolService.GetAllAsync();
        await Task.WhenAll(roomsTask, toolsTask);

        if (roomsTask.Result.Success)
        {
            rooms = roomsTask.Result.Data?.ToList() ?? [];
        }

        if (toolsTask.Result.Success)
        {
            tools = toolsTask.Result.Data?.ToList() ?? [];
        }
    }

    private async Task CreateRoom(RoomRequest request)
    {
        var response = await RoomService.CreateAsync(request);
        if (!response.Success || response.Data is null)
        {
            return;
        }

        rooms.Insert(0, response.Data);
        selectedRoom = response.Data;
        isAdding = false;
        showPanel = true;
    }

    private async Task UpdateRoom(RoomRequest request)
    {
        if (selectedRoom is null)
        {
            return;
        }

        var response = await RoomService.UpdateAsync(selectedRoom.Id, request);
        if (!response.Success || response.Data is null)
        {
            return;
        }

        var savedRoom = response.Data;
        savedRoom.Tools = selectedRoom.Tools;
        var index = rooms.FindIndex(room => room.Id == savedRoom.Id);
        if (index >= 0)
        {
            rooms[index] = savedRoom;
            selectedRoom = savedRoom;
        }

        isEditing = false;
        showPanel = true;
    }

    private async Task AssignToolToRoom(Tool tool)
    {
        if (selectedRoom is null)
        {
            return;
        }

        var request = new ToolRequest
        {
            Name = tool.Name,
            Description = tool.Description,
            Brand = tool.Brand,
            Model = tool.Model,
            SerialNumber = tool.SerialNumber,
            Notes = tool.Notes,
            RoomId = selectedRoom.Id,
            LentToContactId = tool.LentToContactId,
            LentAt = tool.LentAt
        };

        var response = await ToolService.UpdateAsync(tool.Id, request);
        if (!response.Success)
        {
            return;
        }

        var roomId = selectedRoom.Id;
        await LoadRoomData();
        selectedRoom = rooms.FirstOrDefault(room => room.Id == roomId);
        showPanel = selectedRoom is not null;
        isAdding = false;
        isEditing = false;
    }
}
