@page "/tools"
@attribute [Authorize]
@using HouseLedger.Client.RoomService
@using HouseLedger.Client.ToolService
@using HouseLedger.Shared.DTO.Tool
@using HouseLedger.Shared.Models
@inject IRoomService RoomService
@inject IToolService ToolService

<PageTitle>Tools</PageTitle>

<div class="tools-page @(showPanel ? "panel-open" : "list-centered")">
    <div class="tools-heading">
        <div class="tools-page-icon"><MudIcon Icon="@Icons.Material.Filled.Handyman" /></div>
        <div>
            <MudText Typo="Typo.h3" Class="tools-title">Tools</MudText>
            <MudText Typo="Typo.body1" Class="tools-subtitle">Keep track of what you own and where it is.</MudText>
        </div>
    </div>

    <div class="tools-workspace @(showPanel ? "panel-open" : string.Empty)">
        <ToolList Tools="tools"
                  SelectedTool="selectedTool"
                  OnToolSelected="OpenTool"
                  OnAddTool="OpenAdd"
                  OnRefresh="RefreshTools" />

        @if (showPanel)
        {
            <div class="tool-panel">
                <div class="tool-panel-toolbar">
                    <MudText Typo="Typo.subtitle1">@(isAdding ? "New tool" : isEditing ? "Edit tool" : "Tool details")</MudText>
                    <div>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Inherit" Size="Size.Small" OnClick="RefreshTools" AriaLabel="Refresh tools" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Size="Size.Small" OnClick="ClosePanel" AriaLabel="Close tool panel" />
                    </div>
                </div>

                @if (isAdding)
                {
                    <AddTool Rooms="rooms" OnSaved="AddTool" OnCancel="ClosePanel" />
                }
                else if (isEditing && selectedTool is not null)
                {
                    <EditTool Tool="selectedTool" Rooms="rooms" OnSaved="UpdateTool" OnCancel="ClosePanel" />
                }
                else if (selectedTool is not null)
                {
                    <ToolDetail Tool="selectedTool" OnEdit="OpenEdit" OnClose="ClosePanel" />
                }
            </div>
        }
    </div>
</div>

@code {
    private List<Tool> tools = [];
    private List<Room> rooms = [];
    private Tool? selectedTool;
    private bool showPanel;
    private bool isAdding;
    private bool isEditing;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(RefreshTools(), LoadRooms());
    }

    private async Task LoadRooms()
    {
        var response = await RoomService.GetAllAsync();
        if (response.Success)
        {
            rooms = response.Data?.ToList() ?? [];
        }
    }

    private void OpenTool(Tool tool)
    {
        selectedTool = tool;
        showPanel = true;
        isAdding = false;
        isEditing = false;
    }

    private void OpenAdd()
    {
        selectedTool = null;
        showPanel = true;
        isAdding = true;
        isEditing = false;
    }

    private void OpenEdit()
    {
        if (selectedTool is not null)
        {
            isEditing = true;
            isAdding = false;
            showPanel = true;
        }
    }

    private void ClosePanel()
    {
        showPanel = false;
        isAdding = false;
        isEditing = false;
    }

    private async Task RefreshTools()
    {
        var response = await ToolService.GetAllAsync();
        if (response.Success)
        {
            tools = response.Data?.ToList() ?? [];
        }

        selectedTool = null;
        ClosePanel();
    }

    private async Task AddTool(Tool tool)
    {
        var response = await ToolService.CreateAsync(ToRequest(tool));
        if (!response.Success || response.Data is null)
        {
            return;
        }

        tools.Insert(0, response.Data);
        selectedTool = response.Data;
        isAdding = false;
        showPanel = true;
    }

    private async Task UpdateTool(Tool updatedTool)
    {
        if (selectedTool is null)
        {
            return;
        }

        updatedTool.LentToContactId = selectedTool.LentToContactId;
        updatedTool.LentToContact = selectedTool.LentToContact;
        updatedTool.LentAt = selectedTool.LentAt;

        var response = await ToolService.UpdateAsync(updatedTool.Id, ToRequest(updatedTool));
        if (!response.Success || response.Data is null)
        {
            return;
        }

        var savedTool = response.Data;
        var index = tools.FindIndex(tool => tool.Id == savedTool.Id);
        if (index >= 0)
        {
            tools[index] = savedTool;
            selectedTool = savedTool;
        }

        isEditing = false;
        showPanel = true;
    }

    private static ToolRequest ToRequest(Tool tool) => new()
    {
        Name = tool.Name,
        Description = tool.Description,
        Brand = tool.Brand,
        Model = tool.Model,
        SerialNumber = tool.SerialNumber,
        Notes = tool.Notes,
        RoomId = tool.RoomId,
        LentToContactId = tool.LentToContactId,
        LentAt = tool.LentAt
    };
}
