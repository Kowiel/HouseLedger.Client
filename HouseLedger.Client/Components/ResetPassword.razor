@using System.ComponentModel.DataAnnotations

<MudCard Class="profile-card password-card" Elevation="6">
    <MudCardContent Class="profile-card-content">
        <div class="card-heading">
            <div class="card-icon password-icon"><MudIcon Icon="@Icons.Material.Filled.Lock" /></div>
            <div>
                <MudText Typo="Typo.h6">Reset password</MudText>
                <MudText Typo="Typo.caption">Use a strong password to protect your account.</MudText>
            </div>
        </div>

        <EditForm Model="@model" OnValidSubmit="Reset">
            <DataAnnotationsValidator />
            <MudTextField Label="Current password" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                          @bind-Value="model.CurrentPassword" For="@(() => model.CurrentPassword)" InputType="InputType.Password" />
            <MudTextField Label="New password" HelperText="At least 8 characters" Class="profile-field"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Key"
                          @bind-Value="model.NewPassword" For="@(() => model.NewPassword)" InputType="InputType.Password" />
            <MudTextField Label="Confirm new password" Class="profile-field"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LockReset"
                          @bind-Value="model.ConfirmPassword" For="@(() => model.ConfirmPassword)" InputType="InputType.Password" />

            <div class="card-footer">
                @if (updated)
                {
                    <MudText Typo="Typo.caption" Class="saved-message"><MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" /> Password updated</MudText>
                }
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" Class="profile-button">Update password</MudButton>
            </div>
        </EditForm>
    </MudCardContent>
</MudCard>

@code {
    private PasswordForm model = new();
    private bool updated;

    private void Reset(EditContext context)
    {
        updated = true;
    }

    private sealed class PasswordForm
    {
        [Required]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required, MinLength(8)]
        public string NewPassword { get; set; } = string.Empty;

        [Required, Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
