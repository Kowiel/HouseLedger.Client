@using HouseLedger.Client.Auth
@using HouseLedger.Client.UserService
@inject IAuthService AuthService
@inject IUserService UserService

<MudCard Class="profile-card contacts-card" Elevation="6">
    <MudCardContent Class="profile-card-content">
        <div class="card-heading">
            <div class="card-icon contacts-icon"><MudIcon Icon="@Icons.Material.Filled.VerifiedUser" /></div>
            <div>
                <MudText Typo="Typo.h6">Verify your contacts</MudText>
                <MudText Typo="Typo.caption">Verified contacts help keep your account secure.</MudText>
            </div>
        </div>

        <div class="contact-row">
            <div class="contact-type"><MudIcon Icon="@Icons.Material.Filled.Email" /></div>
            <div class="contact-copy">
                <MudText Typo="Typo.subtitle1">Email address</MudText>
                <MudText Typo="Typo.body2">@(email ?? "Not provided")</MudText>
            </div>
            @if (emailVerified)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">Verified</MudChip>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="VerifyEmail">Verify</MudButton>
            }
        </div>

        <div class="contact-row">
            <div class="contact-type"><MudIcon Icon="@Icons.Material.Filled.Phone" /></div>
            <div class="contact-copy">
                <MudText Typo="Typo.subtitle1">Phone number</MudText>
                <MudText Typo="Typo.body2">@(phoneNumber ?? "Not provided")</MudText>
            </div>
            @if (phoneVerified)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">Verified</MudChip>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="VerifyPhone">Verify</MudButton>
            }
        </div>

        <MudText Typo="Typo.caption" Class="verification-note">
            <MudIcon Icon="@Icons.Material.Filled.Info" /> Verification actions will be connected to your account when contact services are enabled.
        </MudText>
    </MudCardContent>
</MudCard>

@code {
    private bool emailVerified;
    private bool phoneVerified;
    private string? email;
    private string? phoneNumber;

    protected override async Task OnInitializedAsync()
    {
        var userId = AuthService.CurrentUserId;
        if (userId is null)
        {
            return;
        }

        var result = await UserService.GetBasicAsync();
        if (result.Success && result.Data is not null)
        {
            email = result.Data.Email;
            phoneNumber = result.Data.PhoneNumber;
        }
    }

    private void VerifyEmail()
    {
        emailVerified = true;
    }

    private void VerifyPhone()
    {
        phoneVerified = true;
    }
}
